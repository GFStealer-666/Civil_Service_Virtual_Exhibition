  m_GameObject: {fileID: 6701547960808380759}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ff4a6980c4a4ebe9d3db88785d62f00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  correction: 0
  isForceFullLineHeight: 0
  isTokenize: 1
  separator: 
  tmpText: {fileID: 8199267663246065700}
  lastKnownText: "1. Onsite \u0E13 \u0E28\u0E39\u0E19\u0E22\u0E4C\u0E1A\u0E23\u0E34\u0E01\u0E32\u0E23\u0E23\u0E48\u0E27\u0E21\n
    \u0E02\u0E2D\u0E07\u0E01\u0E23\u0E30\u0E17\u0E23\u0E27\u0E07\u0E01\u0E32\u0E23\u0E2D\u0E38\u0E14\u0E21\u0E28\u0E36\u0E01\u0E29\u0E32
    \n \u0E27\u0E34\u0E17\u0E22\u0E32\u0E28\u0E32\u0E2A\u0E15\u0E23\u0E4C \u0E27\u0E34\u0E08\u0E31\u0E22\u0E41\u0E25\u0E30\u0E19\u0E27\u0E31\u0E15\u0E01\u0E23\u0E23\u0E21
    (\u0E2D\u0E27.)\n2. Call Center 1313\n3. Online \n 3.1 \u0E40\u0E27\u0E47\u0E1A\u0E44\u0E0B\u0E15\u0E4C
    \u0E2D\u0E27. \n 3.2 \u0E0A\u0E48\u0E2D\u0E07\u0E41\u0E0A\u0E17 Facebook \u0E2D\u0E27.\n
    3.3 \u0E0A\u0E48\u0E2D\u0E07\u0E41\u0E0A\u0E17 1313 \u0E2A\u0E32\u0E22\u0E14\u0E48\u0E27\u0E19
    \u0E2D\u0E27.\n 3.4 \u0E44\u0E1B\u0E23\u0E29\u0E13\u0E35\u0E22\u0E4C\u0E2D\u0E34\u0E40\u0E25\u0E47\u0E01\u0E17\u0E23\u0E2D\u0E19\u0E34\u0E01\u0E2A\u0E4C
    \n (mcs@mhesi.go.th)"
  outputString: "1. Onsite \u200B\u0E13\u200B \u200B\u0E28\u0E39\u0E19\u0E22\u0E4C\u200B\u0E1A\u0E23\u0E34\u0E01\u0E32\u0E23\u200B\u0E23\u0E48\u0E27\u0E21\u200B\n
    \u200B\u0E02\u0E2D\u0E07\u200B\u0E01\u0E23\u0E30\u0E17\u0E23\u0E27\u0E07\u200B\u0E01\u0E32\u0E23\u0E2D\u0E38\u0E14\u0E21\u0E28\u0E36\u0E01\u0E29\u0E32\u200B
    \n \u200B\u0E27\u0E34\u0E17\u0E22\u0E32\u0E28\u0E32\u0E2A\u0E15\u0E23\u0E4C\u200B
    \u200B\u0E27\u0E34\u0E08\u0E31\u0E22\u200B\u0E41\u0E25\u0E30\u200B\u0E19\u0E27\u0E31\u0E15\u0E01\u0E23\u0E23\u0E21\u200B
    \u200B(\u0E2D\u0E27\u200B.)\n2. Call Center 1313\n3. Online \n 3.1 \u200B\u0E40\u0E27\u0E47\u0E1A\u0E44\u0E0B\u0E15\u0E4C\u200B
    \u200B\u0E2D\u0E27\u200B. \n 3.2 \u200B\u0E0A\u0E48\u0E2D\u0E07\u200B\u0E41\u0E0A\u0E17\u200B
    Facebook \u200B\u0E2D\u0E27\u200B.\n 3.3 \u200B\u0E0A\u0E48\u0E2D\u0E07\u200B\u0E41\u0E0A\u0E17\u200B
    1313 \u200B\u0E2A\u0E32\u0E22\u0E14\u0E48\u0E27\u0E19\u200B \u200B\u0E2D\u0E27\u200B.\n
    3.4 \u200B\u0E44\u0E1B\u0E23\u0E29\u0E13\u0E35\u0E22\u0E4C\u200B\u0E2D\u0E34\u0E40\u0E25\u0E47\u0E01\u0E17\u0E23\u0E2D\u0E19\u0E34\u0E01\u0E2A\u0E4C\u200B
    \n \u200B(mcs\u200B@\u200Bmhesi.go.th)"
