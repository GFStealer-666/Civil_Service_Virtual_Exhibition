--- !u!114 &1769948817
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1769948813}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 221becb12e37caa4e8f62da6fa06a022, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panelRoot: {fileID: 655586653}
  closeButton: {fileID: 424337623}
  narratorButton: {fileID: 788602606}
  titleText: {fileID: 470639743}
  subtitleText: {fileID: 0}
  descriptionText: {fileID: 1362028647}
  narrationLabelText: {fileID: 102837657}
  pictureImage: {fileID: 212495107}
  titleTh: "\u0E27\u0E31\u0E15\u0E16\u0E38\u0E1B\u0E23\u0E30\u0E2A\u0E07\u0E04\u0E4C\u0E02\u0E2D\u0E07\u0E27\u0E31\u0E19\u0E02\u0E49\u0E32\u0E23\u0E32\u0E0A\u0E01\u0E32\u0E23\u0E1E\u0E25\u0E40\u0E23\u0E37\u0E2D\u0E19 "
  subtitleTh: 
  narrationLabelTh: "\u0E1C\u0E39\u0E49\u0E1A\u0E23\u0E23\u0E22\u0E32\u0E22\u0E2D\u0E27\u0E15\u0E32\u0E23"
  descriptionTh: "<size=32><b>\u0E40\u0E0A\u0E34\u0E14\u0E0A\u0E39\u0E40\u0E01\u0E35\u0E22\u0E23\u0E15\u0E34\u0E02\u0E49\u0E32\u0E23\u0E32\u0E0A\u0E01\u0E32\u0E23\u0E1E\u0E25\u0E40\u0E23\u0E37\u0E2D\u0E19</b></size>\r\n\u0E22\u0E01\u0E22\u0E48\u0E2D\u0E07\u0E1C\u0E39\u0E49\u0E1B\u0E0F\u0E34\u0E1A\u0E31\u0E15\u0E34\u0E2B\u0E19\u0E49\u0E32\u0E17\u0E35\u0E48\u0E14\u0E49\u0E27\u0E22\u0E04\u0E27\u0E32\u0E21\u0E0B\u0E37\u0E48\u0E2D\u0E2A\u0E31\u0E15\u0E22\u0E4C
    \u0E40\u0E2A\u0E35\u0E22\u0E2A\u0E25\u0E30 \u0E41\u0E25\u0E30\u0E22\u0E36\u0E14\u0E1B\u0E23\u0E30\u0E42\u0E22\u0E0A\u0E19\u0E4C\u0E2A\u0E48\u0E27\u0E19\u0E23\u0E27\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E33\u0E04\u0E31\u0E0D\r\n<size=32><b>\u0E40\u0E2A\u0E23\u0E34\u0E21\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E41\u0E23\u0E07\u0E1A\u0E31\u0E19\u0E14\u0E32\u0E25\u0E43\u0E08\u0E43\u0E19\u0E01\u0E32\u0E23\u0E17\u0E33\u0E07\u0E32\u0E19\u0E20\u0E32\u0E04\u0E23\u0E31\u0E10</b></size>\r\n\u0E01\u0E23\u0E30\u0E15\u0E38\u0E49\u0E19\u0E43\u0E2B\u0E49\u0E02\u0E49\u0E32\u0E23\u0E32\u0E0A\u0E01\u0E32\u0E23\u0E21\u0E38\u0E48\u0E07\u0E21\u0E31\u0E48\u0E19\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E07\u0E32\u0E19\u0E41\u0E25\u0E30\u0E22\u0E01\u0E23\u0E30\u0E14\u0E31\u0E1A\u0E01\u0E32\u0E23\u0E43\u0E2B\u0E49\u0E1A\u0E23\u0E34\u0E01\u0E32\u0E23\u0E1B\u0E23\u0E30\u0E0A\u0E32\u0E0A\u0E19\r\n<size=32><b>\u0E2A\u0E48\u0E07\u0E40\u0E2A\u0E23\u0E34\u0E21\u0E04\u0E38\u0E13\u0E18\u0E23\u0E23\u0E21\u0E41\u0E25\u0E30\u0E18\u0E23\u0E23\u0E21\u0E32\u0E20\u0E34\u0E1A\u0E32\u0E25</b></size>\r\n\u0E2A\u0E19\u0E31\u0E1A\u0E2A\u0E19\u0E38\u0E19\u0E01\u0E32\u0E23\u0E1B\u0E0F\u0E34\u0E1A\u0E31\u0E15\u0E34\u0E23\u0E32\u0E0A\u0E01\u0E32\u0E23\u0E17\u0E35\u0E48\u0E42\u0E1B\u0E23\u0E48\u0E07\u0E43\u0E2A
    \u0E15\u0E23\u0E27\u0E08\u0E2A\u0E2D\u0E1A\u0E44\u0E14\u0E49 \u0E41\u0E25\u0E30\u0E21\u0E35\u0E08\u0E23\u0E34\u0E22\u0E18\u0E23\u0E23\u0E21\r\n<size=32><b>\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E23\u0E30\u0E1A\u0E1A\u0E23\u0E32\u0E0A\u0E01\u0E32\u0E23\u0E2A\u0E39\u0E48\u0E04\u0E27\u0E32\u0E21\u0E17\u0E31\u0E19\u0E2A\u0E21\u0E31\u0E22</b></size>\r\n\u0E1C\u0E25\u0E31\u0E01\u0E14\u0E31\u0E19\u0E01\u0E32\u0E23\u0E1B\u0E23\u0E31\u0E1A\u0E15\u0E31\u0E27\u0E2A\u0E39\u0E48\u0E20\u0E32\u0E04\u0E23\u0E31\u0E10\u0E14\u0E34\u0E08\u0E34\u0E17\u0E31\u0E25\u0E17\u0E35\u0E48\u0E21\u0E35\u0E1B\u0E23\u0E30\u0E2A\u0E34\u0E17\u0E18\u0E34\u0E20\u0E32\u0E1E\u0E41\u0E25\u0E30\u0E15\u0E2D\u0E1A\u0E2A\u0E19\u0E2D\u0E07\u0E15\u0E48\u0E2D\u0E2A\u0E31\u0E07\u0E04\u0E21\r\n<size=32><b>\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E04\u0E27\u0E32\u0E21\u0E40\u0E0A\u0E37\u0E48\u0E2D\u0E21\u0E31\u0E48\u0E19\u0E41\u0E01\u0E48\u0E1B\u0E23\u0E30\u0E0A\u0E32\u0E0A\u0E19</b></size>\r\n\u0E2A\u0E30\u0E17\u0E49\u0E2D\u0E19\u0E1A\u0E17\u0E1A\u0E32\u0E17\u0E02\u0E2D\u0E07\u0E02\u0E49\u0E32\u0E23\u0E32\u0E0A\u0E01\u0E32\u0E23\u0E43\u0E19\u0E01\u0E32\u0E23\u0E02\u0E31\u0E1A\u0E40\u0E04\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E1B\u0E23\u0E30\u0E40\u0E17\u0E28\u0E41\u0E25\u0E30\u0E14\u0E39\u0E41\u0E25\u0E1B\u0E23\u0E30\u0E0A\u0E32\u0E0A\u0E19\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E21\u0E35\u0E04\u0E38\u0E13\u0E20\u0E32\u0E1E"
  imageTh: {fileID: 21300000, guid: 6f2256fc0653d8741b41dddcaeba0714, type: 3}
  narrationFileTh: tts/project3_th.mp3
  titleEn: Objectives of Civil Servant Day
  subtitleEn: 
  narrationLabelEn: Narration
  descriptionEn: '<size=28><b>Honor civil servants</b></size>

    Acknowledging
    those who perform their duties with integrity, selflessness, and prioritize the
    common good

    <size=28><b>Enhance inspiration in public sector work</b></size>

    Encourage
    civil servants to strive for improving work and elevate public service delivery

    <size=28><b>Promote
    ethics and good governance</b></size>

    Support transparent, accountable,
    and ethical public service practices

    <size=28><b>Develop the bureaucracy
    towards modernization</b></size>

    Drive adaptation to an efficient digital
    government that responds to society

    <size=28><b>Build public confidence</b></size>

    Reflect
    the role of civil servants in driving the country forward and caring for citizens
    with quality'
  imageEn: {fileID: 21300000, guid: 11d1e3e8564007b4a9f86df467f45b8d, type: 3}
